{
  "name": "ripo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/bot && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/bot && npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=apps/bot",
    "dev:bot": "npm run dev --workspace=apps/bot",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:push": "npm run db:push --workspace=packages/database",
    "db:migrate": "npm run db:migrate --workspace=packages/database"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
